---
// ================================================================
// Split.astro — каркас диагональной split-секции (направления).
// Медиа-колонка — нативная scroll-snap галерея: прокрутку даёт браузер,
// JS только синхронизирует точки.
//
// Слайд — фото или видео-петля (Clip): ролик играет, пока слайд
// на экране. Кадры и ролики собирает `npm run media`
// (tools/media.config.mjs), сюда приходят их ключи.
// ================================================================
import Photo from './Photo.astro';
import Clip from './Clip.astro';

interface PhotoFrame {
    /** Ключ кадра в src/data/media.json, например 'combat/1'. */
    name: string;
    alt: string;
}

interface ClipFrame {
    /** Имя ролика в /assets/video/ без расширения. */
    clip: string;
    /** Ключ постера в src/data/media.json. */
    poster: string;
    alt: string;
}

type Frame = PhotoFrame | ClipFrame;

interface Props {
    id: string;
    num: string;
    ariaLabel: string;
    /** Модификатор темы: combat | sambo | striking | morning | fp-kids */
    modifier: string;
    reverse?: boolean;
    /** Крупные строки заголовка (display-типографика). */
    titleLines: string[];
    /** Продолжение h2 — сюда идёт поисковый запрос целиком. */
    titleSub: string;
    /** Кадры галереи — по порядку показа. */
    photos: Frame[];
    /** Фоновое слово-декорация для параллакса. */
    bgWord?: string;
}

const {
    id, num, ariaLabel, modifier, reverse = false,
    titleLines, titleSub, photos, bgWord,
} = Astro.props;

const slides = photos.length;
// Рамка медиа — половина экрана на десктопе и весь экран на мобильном.
const SIZES = '(min-width: 961px) 50vw, 100vw';
import '../styles/sections/split.css';

---
<section
    class:list={['split', `split--${modifier}`, reverse && 'split--reverse']}
    id={id}
    aria-labelledby={`${id}-title`}
>
    {bgWord && <div class="bg-word bg-word--split" data-word={bgWord} aria-hidden="true"></div>}

    <div class="split__media" data-carousel>
        <!--
          Липкая рамка. Когда «Подробнее» раскрыто, текстовая колонка
          вырастает в несколько экранов и медиа уезжало вверх вместе
          с ней — читатель терял его из виду. Теперь кадры остаются
          перед глазами всё время, пока он читает.
        -->
        <div class="split__media-sticky">
            <div class="split__media-track" data-carousel-track
                 tabindex="0" role="group" aria-label={`Галерея: ${ariaLabel}`}>
                {photos.map((p) => (
                    <div class="split__slide">
                        <div class="split__slide-inner">
                            {'clip' in p
                                ? <Clip src={p.clip} poster={p.poster} label={p.alt} />
                                : <Photo name={p.name} alt={p.alt} sizes={SIZES} class="split__img" />}
                        </div>
                    </div>
                ))}
            </div>


            {slides > 1 && (
                <div class="split__media-dots">
                    {photos.map((_, i) => (
                        <button class:list={['split__media-dot', i === 0 && 'is-active']}
                                type="button" data-carousel-dot
                                aria-label={`Кадр ${i + 1} из ${slides}`}></button>
                    ))}
                </div>
            )}
        </div>
    </div>

    <div class="split__content">
        <div class="split__num reveal" aria-hidden="true">{num}</div>
        <h2 class="split__title reveal" id={`${id}-title`} data-delay="2">
            <span class="display split__title-main">
                {titleLines.map((line, i) => (
                    <>
                        {i > 0 && <br />}
                        <span class="display--skew">{line}</span>
                    </>
                ))}
            </span>
            <span class="split__title-sub">{titleSub}</span>
        </h2>
        <slot />
        <slot name="details" />
    </div>
</section>
