---
// ================================================================
// Directions.astro — три направления на весь экран.
//
// Десктоп: три высокие колонки с косыми границами (6°, как наклон
// заголовков сайта). Ролики вертикальные, а колонка — почти их
// пропорция, поэтому действие видео всегда в центре кадра. Наведение
// расширяет колонку и запускает видео. Телефон и планшет: три полосы.
// Постер — декорация: смысл несёт текст ссылки, поэтому alt пустой.
// ================================================================
import Photo from '../Photo.astro';
import { url } from '../../lib/url';

// Доступное имя ссылки складывается из её же видимого текста.
const SIZES = '(min-width: 961px) 45vw, 100vw';
const SECTORS = [
    { id: 'combat', num: '01', lines: ['Боевое', 'самбо'], sub: 'Дети с 10 лет · юноши 16–18 лет · взрослые 18+',
      video: url('/assets/video/combat-1.mp4') },
    { id: 'sambo', num: '02', lines: ['Спортивное', 'самбо'], sub: 'Дети с 6 лет и взрослые',
      video: url('/assets/video/sambo-1.mp4') },
    { id: 'striking', num: '03', lines: ['Ударная', 'техника'], sub: 'Мужчины, девушки, юноши',
      video: url('/assets/video/striking-1.mp4') },
];
import '../../styles/sections/directions.css';

---
<section class="directions grain" id="directions" aria-labelledby="directions-title">
    <h2 class="visually-hidden" id="directions-title">Направления подготовки в Туле</h2>

    {SECTORS.map((s) => (
        <a href={`#${s.id}`}
           class:list={['direction-sector', `direction-sector--${s.id}`]}
           data-video={s.video}>
            <Photo name={`directions/${s.id}`} alt="" sizes={SIZES}
                   class="direction-sector__media direction-sector__media--img" />
            <video class="direction-sector__media direction-sector__media--video"
                   muted loop playsinline preload="none"></video>
            <div class="direction-sector__veil" aria-hidden="true"></div>
            <div class="direction-sector__label">
                <div class="direction-sector__num" aria-hidden="true">{s.num}</div>
                <div class="direction-sector__name">
                    <span class="display--skew">{s.lines[0]}</span>
                    <span class="display--skew">{s.lines[1]}</span>
                </div>
                <div class="direction-sector__sub">{s.sub}</div>
                <div class="direction-sector__arrow" aria-hidden="true">→</div>
            </div>
        </a>
    ))}
</section>

<script>
    import { initDirections } from '../../scripts/directions.js';
    initDirections();
</script>
