---
import Split from '../Split.astro';
---
<Split
    id="fp-kids"
    num="05"
    ariaLabel="Общая физическая подготовка для детей 4–6 лет"
    modifier="fp-kids"
    titleLines={['Общая физическая', 'подготовка']}
    titleSub="ОФП для детей 4–6 лет в Туле: первые шаги в спорте"
    slides={3}
    bgWord="СТАРТ"
>
    <div class="split__offers reveal" data-delay="3">
        <div class="offer">
            <div class="offer__kind">Индивидуальные занятия</div>
            <div class="offer__for">ОФП для детей 4–6 лет</div>
            <ul class="offer__list">
                <li>мягкий формат для знакомства со спортом</li>
                <li>координация, ловкость, гибкость, базовая гимнастика</li>
                <li>длительность занятия подбирается по возрасту</li>
                <li>время тренировок подбирается индивидуально</li>
            </ul>
        </div>
    </div>
</Split>
