---
// ================================================================
// Merch.astro — единая форма команды Kop.team.
// Фото — из постов тренера во ВКонтакте (март–апрель 2026).
// Основной кадр — вещь в деле, при наведении проявляется второй:
// сама вещь крупно. На тач-экранах виден только основной.
// ================================================================
import Photo from '../Photo.astro';

const ITEMS = [
    {
        num: '01', title: 'Футболки', photo: 'merch/tee', photoAlt: 'merch/tee-alt',
        desc: 'Белые и чёрные футболки с эмблемой Kop.team Sambo Club — для тренировок, разминок и выездов.',
        alt: 'Тренер в белой футболке Kop.team Sambo Club в зале борьбы, вид со спины',
    },
    {
        num: '02', title: 'Нашивки', photo: 'merch/patch', photoAlt: 'merch/patch-alt',
        desc: 'Нашивка на спину куртки самбо: фамилия спортсмена, RUS, Тула и Kop.team. Знак команды на соревнованиях и сборах.',
        alt: 'Нашивка на спине красной куртки самбо: фамилия, RUS, Тула, Kop.team',
    },
    {
        num: '03', title: 'Спортивные костюмы', photo: 'merch/suit', photoAlt: 'merch/suit-alt',
        desc: 'Олимпийка с эмблемой клуба уже есть, полный спортивный костюм Kop.team — в работе. Парадная и выездная форма для сборов и соревнований.',
        alt: 'Белая олимпийка с эмблемой Kop.team Sambo Club, вид со спины',
    },
];
import '../../styles/sections/merch.css';

---
<section class="merch" id="merch" aria-labelledby="merch-title">
    <div class="bg-word bg-word--merch" data-word="ЕДИНСТВО" aria-hidden="true"></div>

    <div class="merch__head">
        <div class="merch__head-left">
            <h2 class="display merch__title reveal" data-delay="1" id="merch-title">
                <span class="display--skew">Один ковёр.</span><br>
                <span class="display--skew merch__title-accent">Одна форма.</span>
            </h2>
        </div>
        <p class="merch__intro reveal" data-delay="2">
            Единая экипировка — это не про моду. Это про ощущение: ты часть команды,
            у которой общая цель и общий ритм. Футболки, нашивки на куртки и спортивные
            костюмы с символикой команды — чтобы узнавать своих не только на татами,
            но и за его пределами.
        </p>
    </div>

    <div class="merch__grid">
        {ITEMS.map((it, i) => (
            <article class="merch-card reveal" data-delay={i + 1}>
                <div class="merch-card__media">
                    <Photo name={it.photo} alt={it.alt} class="merch-card__img"
                           sizes="(max-width: 960px) 100vw, 33vw" />
                    <Photo name={it.photoAlt} alt="" class="merch-card__img merch-card__img--alt"
                           sizes="(max-width: 960px) 100vw, 33vw" />
                </div>
                <div class="merch-card__body">
                    <div class="merch-card__num">{it.num}</div>
                    <h3 class="merch-card__title">{it.title}</h3>
                    <p class="merch-card__desc">{it.desc}</p>
                </div>
            </article>
        ))}
    </div>

    <div class="merch__foot reveal" data-delay="3">
        <div class="merch__foot-line" aria-hidden="true"></div>
        <p class="merch__foot-text">Ассортимент и размеры — по запросу в мессенджерах.</p>
    </div>

    <!-- Партнёр клуба — по просьбе тренера (голосовое от 18.04.2026),
         ссылка — от 02.10.2026. Название магазин пишет с «ъ»: «Единоборецъ».
         TODO(владелец): логотип магазина, когда будет.
         Обычный div, а не aside: вложенный в <main> aside — ориентир
         «дополнительное содержимое» не на своём месте (axe: landmark-
         complementary-is-top-level), а заголовок h3 и так даёт структуру. -->
    <div class="partner reveal" data-delay="3">
        <div class="partner__kicker">Партнёр клуба</div>
        <h3 class="partner__name display">
            <span class="display--skew">«Единоборецъ»</span>
        </h3>
        <p class="partner__text">
            Магазин экипировки для единоборств в Туле на ул. Красина, 10, и в интернете.
            Его основатель — Глеб Петров, мастер спорта России и воспитанник нашего
            клуба. Куртки, борцовки, перчатки и защита — у своих.
        </p>
        <a class="partner__link" href="https://xn--90afccn4ahbs5d2b.xn--p1ai/"
           target="_blank" rel="noopener noreferrer">
            На сайт единоборецъ.рф
            <svg width="18" height="12" viewBox="0 0 18 12" fill="none"
                 stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M1 6H17M17 6L12 1M17 6L12 11" />
            </svg>
        </a>
    </div>
</section>
