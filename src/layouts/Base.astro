---
// ================================================================
// Base.astro — общий каркас: head-мета, CSP, шрифты, глобальные
// стили, навбар, футер. Вся SEO-обвязка приходит пропсами страницы.
// ================================================================
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import { SITE_URL, BRAND } from '../data/site';
import { url } from '../lib/url';

import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/nav.css';
import '../styles/animations.css';
import '../styles/decor.css';

interface Props {
    title: string;
    description: string;
    /** Путь от корня со слешами по краям: '/', '/faq/'. */
    path: string;
    /** Узлы JSON-LD; складываются в один @graph. */
    schema?: Record<string, unknown>[];
    ogType?: string;
    /** Служебные страницы вроде 404 из индекса исключаем. */
    noindex?: boolean;
    preloader?: boolean;
    /** На главной пункты меню — якоря, на остальных — ссылки на главную. */
    home?: boolean;
}

const {
    title,
    description,
    path,
    schema = [],
    ogType = 'website',
    noindex = false,
    preloader = false,
    home = false,
} = Astro.props;

const canonical = `${SITE_URL}${path}`;
const ogImage = `${SITE_URL}/assets/img/og/og-default.jpg`;

// GitHub Pages не отдаёт HTTP-заголовков — политику вешаем метатегом.
const CSP = [
    "default-src 'self'",
    "img-src 'self' data:",
    "style-src 'self'",
    "script-src 'self'",
    // Плагинов (<object>/<embed>) на сайте нет — запрещаем явно, а не
    // через default-src 'self'.
    "object-src 'none'",
    "base-uri 'self'",
    "form-action 'none'",
    // frame-ancestors СОЗНАТЕЛЬНО не включён, хотя и был в ТЗ: в <meta>
    // браузеры эту директиву игнорируют и пишут ошибку в консоль на каждой
    // странице (ломает критерий «нет CSP-нарушений в консоли» и снимает
    // 4 балла с Lighthouse Best Practices). Защиту от фрейминга даёт только
    // HTTP-заголовок, а GitHub Pages заголовков не отдаёт.
    // При переезде на хостинг с заголовками добавить туда
    // `Content-Security-Policy: frame-ancestors 'none'` (или X-Frame-Options).
].join('; ');

const jsonLd = schema.length
    ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schema })
    : null;
---
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0E0E10" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Копейкин Павел Сергеевич" />
    <!-- noindex и canonical вместе — противоречивые сигналы, а 404 к тому же
         отдаётся по любому адресу: собственного URL у неё нет. -->
    {noindex
        ? <meta name="robots" content="noindex, follow" />
        : <link rel="canonical" href={canonical} />}

    <!-- Критичные шрифты первого экрана: стартуют, не дожидаясь парсинга CSS. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href={url('/fonts/files/TK3IWkUHHAIjg75cFRf3bXL8LICs1_Fv40pKlN4NNSeSASz7FmlSHYjedg.woff2')} />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href={url('/fonts/files/xn7gYHE41ni1AdIRggOxSuXd.woff2')} />

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Копейкин Павел Сергеевич — тренер по самбо в Туле" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={BRAND} />

    <!-- Twitter / X-card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons. PNG и OG-картинку рисует tools/og/make_og.py. -->
    <link rel="icon" type="image/svg+xml" href={url('/assets/icons/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/assets/icons/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={url('/assets/icons/favicon-16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('/assets/icons/apple-touch-icon.png')} />

    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}

    <!-- Постраничные дополнения head: например, preload LCP-картинки. -->
    <slot name="head" />
</head>
<body>
{preloader && <Preloader />}

<a class="skip-link" href="#main">К основному содержанию</a>

<Nav home={home} />

<main id="main">
    <slot />
</main>

<Footer />

<script>
    import { initReveal } from '../scripts/reveal.js';
    initReveal();
</script>
</body>
</html>
